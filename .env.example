# Copy to .env.local (or .env) for local dev and set the same names in Vercel → Project → Settings → Environment Variables.
# Placeholders only. Never commit real values. Never prefix a secret with NEXT_PUBLIC_.

# --- Browser-safe (inlined into the client bundle) -------------------------
# Supabase → Project Settings → API (Data API URL and the *publishable* key, sb_publishable_...)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
# Public URL of the deployed app (used in Telegram reminder links). Local: http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Server-only (Next.js server / Vercel) ---------------------------------
# Supabase → Project Settings → API keys → *secret* key (sb_secret_...). Used only for
# Admin user management, the verified Telegram webhook and the shared niche cache.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx
# Internal login domain for username → Auth email mapping (e.g. "login.yourcompany.com").
# Use a domain/subdomain you own. Staff never receive email there. Do not change after users exist.
AUTH_LOGIN_DOMAIN=login.example.com

# Telegram bot from @BotFather
TELEGRAM_BOT_TOKEN=123456789:replace-with-bot-token
# Bot username without "@", used to build the t.me deep link
TELEGRAM_BOT_USERNAME=your_crm_bot
# Random string (1-256 chars of A-Z a-z 0-9 _ -). Generate: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=replace-with-random-hex

# --- First-admin bootstrap (only when running scripts/bootstrap-admin.mjs) --
# Optional; if unset, the script prompts for the password without echoing it.
# BOOTSTRAP_ADMIN_PASSWORD=

# --- Facebook Ads sync (server only) -----------------------------------------
# Shared with Supabase Vault 'crm_ads_sync_secret'; the hourly cron sends it as a Bearer token.
ADS_SYNC_SECRET=replace-with-random-hex   # openssl rand -hex 32

# --- Supabase Edge Function secrets (NOT read by Next.js) ------------------
# Set with: supabase secrets set --env-file supabase/functions/.env  (see README)
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected automatically by Supabase.
# REMINDER_WORKER_SECRET=replace-with-random-hex   # openssl rand -hex 32
# TELEGRAM_BOT_TOKEN=123456789:replace-with-bot-token
# APP_URL=https://your-app.vercel.app

# --- Supabase Vault (SQL editor, NOT env vars) ------------------------------
# select vault.create_secret('https://your-project-ref.supabase.co', 'crm_project_url');
# select vault.create_secret('<same value as REMINDER_WORKER_SECRET>', 'crm_reminder_worker_secret');
# Hourly Facebook Ads sync (calls the app's /api/ads/sync):
# select vault.create_secret('https://your-app.vercel.app', 'crm_app_url');
# select vault.create_secret('<same value as ADS_SYNC_SECRET>', 'crm_ads_sync_secret');
