{
  "name": "code-ansar",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/copy-cad-assets.mjs && next dev",
    "build": "node scripts/copy-cad-assets.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "db:types": "node scripts/gen-db-types.mjs",
    "db:types:remote": "supabase gen types typescript --linked --schema public > src/lib/database.types.ts",
    "bootstrap:admin": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/bootstrap-admin.mjs",
    "telegram:webhook": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/set-telegram-webhook.mjs",
    "seed:demo": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/seed-demo.mjs",
    "seed:star-gardens": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/seed-star-gardens.mjs",
    "storage:cors": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/tigris-cors.mjs",
    "storage:migrate": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/migrate-storage-to-tigris.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@aws-sdk/s3-request-presigner": "^3.1146.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.9.1",
    "@mlightcad/cad-simple-viewer": "1.7.4",
    "@mlightcad/data-model": "1.15.1",
    "@mlightcad/libredwg-converter": "3.15.1",
    "@mlightcad/mtext-parser": "^1.5.3",
    "@mlightcad/mtext-renderer": "^0.13.3",
    "@mlightcad/three-renderer": "1.7.4",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "@tanstack/react-table": "^8.21.3",
    "@tiptap/extension-highlight": "^3.31.4",
    "@tiptap/extension-text-style": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "echarts": "^6.1.0",
    "leaflet": "^1.9.4",
    "libphonenumber-js": "^1.13.14",
    "lodash-es": "4.17.21",
    "lucide-react": "^1.52.0",
    "next": "16.3.8",
    "next-themes": "^0.4.6",
    "pdfjs-dist": "^6.4.299",
    "qrcode.react": "^4.2.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.89.0",
    "react-leaflet": "^5.0.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.1",
    "sonner": "^2.0.8",
    "three": "^0.172.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
