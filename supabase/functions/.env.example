# Edge Function secrets. Copy to supabase/functions/.env, fill in, then:
#   supabase secrets set --env-file supabase/functions/.env
REMINDER_WORKER_SECRET=replace-with-random-hex
TELEGRAM_BOT_TOKEN=123456789:replace-with-bot-token
APP_URL=https://your-app.vercel.app

# WhatsApp alerts (optional; see README "WhatsApp alerts"). Leave empty to use Telegram only.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# Optional and PAID (a utility template per closed window). Leave empty to never pay.
WHATSAPP_REOPEN_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=en
